# Generate local values with ./scripts/init-env.ps1; do not commit .env.
DB_PASSWORD=replace-with-a-random-password
JWT_SECRET=replace-with-a-base64-encoded-32-byte-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ELASTICSEARCH_HOST_PORT=19200
# Для Expo Go на телефоне в той же Wi-Fi сети укажите IPv4-адрес компьютера.
BACKEND_HOST=127.0.0.1
