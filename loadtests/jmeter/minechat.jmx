            <stringProp name="parameters"></stringProp>
            <stringProp name="script">if (prev.getResponseCode() != &apos;200&apos;) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Unexpected HTTP status: &apos; + prev.getResponseCode()); return }
try {
 def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
 if (!(json.items instanceof List &amp;&amp; json.items.any { it.id.toString() == vars.get(&quot;messageId&quot;) &amp;&amp; it.text == vars.get(&quot;messageText&quot;) })) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Response contract check failed&apos;) }
} catch (Exception ignored) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Invalid JSON response&apos;) }</stringProp>
          </JSR223Assertion>
